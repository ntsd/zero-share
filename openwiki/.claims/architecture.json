        }
      ]
    },
    {
      "id": "claim_6ae27ef5450f44fab921f7e1e98da446",
      "statement": "Application-layer encryption is optional and off by default: when enabled, each file gets its own AES-256-GCM key wrapped with the receiver's RSA-OAEP-2048 public key, with the wrapped key delivered inside the metaData message, protecting file content from SDP-exchange MITM on top of DTLS. The answer peer awaits the validated p-param import before generating its own RSA pair for the answer code.",
      "evidence": [
        {
          "resource": "repo://src/components/OfferPage.svelte#L43-L48",
          "version": "repo-lines-v1:sha256:1aec21e248eca9a1a403f300a236a6e7699379747aad692a21596bceddce8b1a:"
