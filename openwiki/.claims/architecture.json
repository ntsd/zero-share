          "version": "repo-lines-v1:sha256:f9c7eb1f69cb9764cf555f5de72fd7552402aeb3dd63f9c401f50a9f98524e2a:"
        }
      ]
    },
    {
      "id": "claim_b86a754e98484958a26fa97b32d7b186",
      "statement": "The file transfer protocol is receiver-ack chunking: the sender emits metaData, waits for EVENT_RECEIVER_ACCEPT, then sends one chunk per EVENT_RECEIVED_CHUNK acknowledgment sent by the receiver — a simple backpressure loop pacing the transfer.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L119-L124",
          "version": "repo-lines-v1:sha256:02b3f1df535970c554616e3e3b67562305f1c18643a11f5b377240e17a725827:"
        },
