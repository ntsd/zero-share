    {
      "id": "claim_723fc0d4ed98488bbf69000602bbdb1a",
      "statement": "SDP is made URL-safe for link transport via sdp-compact compaction plus character substitutions (/ -> _, + -> ~, = -> -) on encode and their reversal on decode, with an isOffer flag matching the SDP role; sdpDecode throws synchronously on malformed input (empty string, invalid base64, or a decompressed payload that is not SDP), so callers of user-controllable input must guard with try/catch (documented in source at PR #45; tests/sdp-robustness.test.mjs pins the throw behavior).",
      "evidence": [
        {
          "resource": "repo://src/utils/sdpEncode.ts#L1-L14",
          "version": "repo-lines-v1:sha256:09ef7b5faf799f49424b876f746592ad7607e9fd4f59131fa790fa286c5884a7:"
