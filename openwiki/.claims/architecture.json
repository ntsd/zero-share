        }
      ]
    },
    {
      "id": "claim_bdfbcf417c194e6fb0917dee36ad1312",
      "statement": "The '/' route renders the OfferPage (initiator role) and '/receive' renders the ReceivePage (responder role); each Astro page is a thin wrapper mounting one Svelte component under the shared MainLayout.",
