    {
      "id": "claim_0d8574c6717049c2b9b514639210ae5f",
      "statement": "The wire formats are: SDP encoded via sdp-compact plus URL-safe substitutions (/ -> _, + -> ~, = -> -); offer link ?s=<offerSDP> plus optional i (STUN override), c (chunk size, validated against CHUNK_SIZE_OPTIONS with 32 KB fallback), and p (base64 RSA public key, encryption only); answer code <encodedAnswerSDP>|<base64 RSA public key or empty>.",
      "evidence": [
