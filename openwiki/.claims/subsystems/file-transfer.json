          "version": "repo-lines-v1:sha256:617fef145ee06930337a49f4ab4103e69f6fefd7a78c10d1982f94b35c782efc:"
        }
      ]
    },
    {
      "id": "claim_6db6ca55760d4a5dbdf53c81700b8f96",
      "statement": "A defensive empty-chunk guard aborts the send with an 'Invalid chunk size' error when a chunk reads 0 bytes while bytes remain, preventing an infinite loop of empty sends caused by an invalid chunkSize (e.g. a crafted 'c' URL param).",
      "evidence": [
