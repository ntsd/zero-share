    {
      "id": "claim_1f6139294f964ab68235b8677a480e74",
      "statement": "The receiver keeps per-file chunk buffers, byte counters, and per-file processing chains in deliberately non-reactive plain objects (receivingFileChunkMap / receivingFileStatsMap / chunkQueue) so chunk arrival does not trigger Svelte re-renders; only the reactive receivingFiles map is flushed at the 3-point progress step.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L25-L35",
          "version": "repo-lines-v1:sha256:6ebb7113cb6eab5950d180f2d8db9034b76ef39bfc33c8b3bb81084ad45c2842:"
