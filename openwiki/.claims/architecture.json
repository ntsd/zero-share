    {
      "id": "claim_500ea4007b4e4a9aaee2b504b668c323",
      "statement": "Peer connections are configured with a single ICE server (default stun:stun.l.google.com:19302) resolved through the shared isSupportedIceServer/resolveIceServer predicates in src/configs.ts, which accept the built-in STUN allowlist plus any well-formed stun:/turns: URL; the sender enforces the predicate on both the emitted `i` link param and its own RTCPeerConnection and the receiver enforces the same predicate on the accepted `i` param, so a custom/TURN server chosen on the sender is always honored and the two peers can never diverge; anything else falls back to the default with an error toast on both sides, and no relay server exists.",
      "evidence": [
        {
          "resource": "repo://src/components/OfferPage.svelte#L63-L85",
          "version": "repo-lines-v1:sha256:30b5c16f83fc5c9dba97171c7690348e37493c5fe12f06198030d97b37959359:"
        },
        {
          "resource": "repo://src/components/ReceivePage.svelte#L62-L77",
          "version": "repo-lines-v1:sha256:d1304e576b1c9dc05cfa33363f2a1876ca6fa707fbe0a3cd76ea5e3a907c64ac:"
        },
        {
          "resource": "repo://src/configs.ts#L3-L20",
          "version": "repo-lines-v1:sha256:c00b9efd6a2cfdc59b8ea662e4b2f7caa2b4e8b1f7ba1b658a9bc0d3ec4d7a3d:"
        },
        {
          "resource": "repo://src/configs.ts#L47-L54",
