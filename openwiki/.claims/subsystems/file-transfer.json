    {
      "id": "claim_0489f3cde91743e7b351af897e8841ab",
      "statement": "The sender maintains per-file state in a reactive map with lifecycle Pending -> WaitingAccept -> Processing -> Success; on ACCEPT it starts the chunk loop, on REJECT or VALIDATE_ERROR it records the error and resets the file to Pending (retryable); the async event handlers re-read the live entry after each await and bail if it was removed, and chunk-send failures land as visible error entries instead of unhandled rejections.",
      "evidence": [
        {
          "resource": "repo://src/components/sender/Sender.svelte#L23-L124",
          "version": "repo-lines-v1:sha256:5313f2d2e14696fc3698f4374a67cd5a4c3d27def17455900d8ab59bd6028def:"
        },
        {
