    {
      "id": "claim_5712564d44244197a155ef4bdc054f9f",
      "statement": "Each picked file gets a fresh AES-256-GCM key that is exported raw and RSA-wrapped with the receiver's public key; the wrapped key bytes travel in MetaData.key and the receiver unwraps them with its private key in onMetaData, keeping the result on the file detail for chunk decryption. The receiver registers the file entry at WaitingAccept BEFORE the async key decryption, and on unwrap failure sets a visible error on the entry, toasts, and returns without accepting.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L37-L65",
