    {
      "id": "claim_e5da1d3058e24c759841da47ea4689bc",
      "statement": "onMetaData registers the file entry at WaitingAccept BEFORE the async AES key decryption, so the file is visible and removable throughout; if the RSA key unwrap fails, the entry gets a visible error and an error toast instead of the file silently never appearing while the sender waits for an accept that will not come.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L37-L65",
          "version": "repo-lines-v1:sha256:81a2a0d84a26fa787275e0f483e70787fbc6a0e7a0ba4eb8d51514fe38ecd515:"
        }
      ]
    },
    {
      "id": "claim_751a4c446d704d06bb604415143ed824",
      "statement": "Per-file chunk processing is serialized on a per-file promise chain (serializeTask): processChunk for chunk N+1 cannot start before chunk N's processing has settled, so decrypt/push/stats/blob-on-complete run in strict arrival order even when WebCrypto decrypt completions are out of order; a failed chunk swallows its rejection on the chain and cannot stall the queue.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L93-L110",
          "version": "repo-lines-v1:sha256:828a89fafaa973523ca2c4c117c31d7722b6c8c04ebde95bb8d548f89cc3b0a5:"
