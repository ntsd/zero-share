    {
      "id": "claim_751a4c446d704d06bb604415143ed824",
      "statement": "Per-file chunk processing is serialized on a per-file promise chain (serializeTask): processChunk for chunk N+1 cannot start before chunk N's processing has settled, so decrypt/push/stats/blob-on-complete run in strict arrival order even when WebCrypto decrypt completions are out of order; the chain's catch routes any error to rejectCorruptChunk (idempotent — no-op once the per-file chunk map is gone) instead of swallowing it, so a failed chunk can never leave the file permanently incomplete or stall the queue.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L93-L116",
