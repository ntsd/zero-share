    {
      "id": "claim_0489f3cde91743e7b351af897e8841ab",
      "statement": "The sender maintains per-file state in a reactive map with lifecycle Pending -> WaitingAccept -> Processing -> Success; on ACCEPT it starts the chunk loop, on REJECT or VALIDATE_ERROR it records the error and resets the file to Pending (retryable).",
      "evidence": [
        {
          "resource": "repo://src/components/sender/Sender.svelte#L46-L84",
          "version": "repo-lines-v1:sha256:f3a38db575ead4a8e155b569fb21fd2b1b4bb03b75e167d1f6300130da961b0b:"
