    {
      "id": "claim_02260b9d041440448fda65b10f4bc46c",
      "statement": "Connection setup is offer-link driven: the offer peer generates an RTCPeerConnection, data channel, and SDP offer (waiting up to 3 seconds for ICE candidates), while the answer peer decodes the user-controllable offer SDP from the URL inside a try/catch (toast 'Invalid SDP in link' instead of a page crash, PR #45), awaits the validated p-param key import, generates the answer plus its RSA key pair (when encrypted), and returns the answer code; the channel opens on both sides once the offer peer accepts it (answer SDP decode also guarded with try/catch, toast 'Invalid answer code', PR #45).",
      "evidence": [
        {
          "resource": "repo://src/components/OfferPage.svelte#L62-L134",
          "version": "repo-lines-v1:sha256:a63b7a78e4adac8bcd20d2fce09e289aefda03b4efbb420058c91a9a8f9fdce7:"
