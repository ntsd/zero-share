        }
      ]
    },
    {
      "id": "claim_fa837c572a3542b392cf3d6ec0f34834",
      "statement": "The transfer protocol is receiver-ack chunking: the receiver enqueues each incoming chunk onto a per-file serialized chain (onChunkData), and processChunk sends EVENT_RECEIVED_CHUNK after successful decryption and a re-check that the file is still active, so the sender sends at most one next chunk per ack until offset reaches metaData.size — backpressure pacing the transfer with the sender one round-trip ahead.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L106-L129",
          "version": "repo-lines-v1:sha256:29b4b6b97cc0a7b281ea02334735500bf085c586f724ab9d1e3448a6df8e4150:"
        },
