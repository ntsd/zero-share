    {
      "id": "claim_df6f737c2b7647a996d1311ce7f78e3a",
      "statement": "Chunk-level encryption wraps the transfer framing: the sender encrypts each chunk buffer before Message-encoding it as a chunk, and the receiver decrypts each decoded chunk (only when isEncrypt and the per-file aesKey are both present), inside the per-file serialized processChunk task, before accumulating bytes toward the declared file size; the receiver's EVENT_RECEIVED_CHUNK ack is sent only after successful decryption and after re-checking the file is still active, so a corrupt chunk never advances the sender.",
      "evidence": [
        {
          "resource": "repo://src/components/receiver/Receiver.svelte#L125-L154",
          "version": "repo-lines-v1:sha256:dd3542ab020a2de013075efc2ac922eda5954019b5ceecbefc8b0b1526515f5f:"
